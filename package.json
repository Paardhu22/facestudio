{
  "name": "facestudio",
  "version": "0.1.0",
  "private": true,
  "description": "FaceStudio — web-based batch image editor for intelligent face cropping, adjustments, and full-resolution batch export.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev --port 3100",
    "build": "next build",
    "start": "node scripts/run.mjs start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "node scripts/setup-mediapipe.mjs",
    "prebuild": "node scripts/setup-mediapipe.mjs",
    "worker": "node --conditions=react-server --import tsx server/worker/main.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@next/env": "16.4.5",
    "@tanstack/react-virtual": "3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "10.9.1",
    "lucide-react": "^1.67.0",
    "next": "16.4.5",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "react-resizable-panels": "^4.18.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0",
    "tsx": "4.23.15",
    "yazl": "3.3.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0",
    "yauzl": "^3.4.0"
  }
}
