# FaceStudio server configuration (SKILLS.md §D.12). All values are optional; defaults shown.
# Server-side only — none of these are exposed to the browser.

# Storage root for SQLite DB, originals, renditions, and export artifacts.
# FS_STORAGE_DIR=./.data/storage

# Batch and image limits
# FS_MAX_BATCH_IMAGES=3000
# FS_MAX_FILE_BYTES=52428800          # 50 MiB
# FS_MAX_BATCH_BYTES=16106127360      # 15 GiB
# FS_MAX_IMAGE_PIXELS=100000000       # 100 MP decode limit (decompression-bomb guard)
# FS_MAX_IMAGE_SIDE=20000
# FS_MAX_OUTPUT_SIDE=16383

# Worker
# FS_WORKER_CONCURRENCY=4
# FS_MAX_ATTEMPTS=3

# Retention
# FS_SESSION_TTL_HOURS=24
# FS_ARTIFACT_TTL_HOURS=24
